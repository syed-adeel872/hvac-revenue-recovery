# ============================================================
# HVAC Revenue Recovery — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Public URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anonymous (public) key — safe for client-side use
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct database connection string (for migrations / psql)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------
# LLM Provider (OpenAI-compatible endpoint)
# ------------------------------------------------------------
# Base URL for the LLM API (e.g., OpenAI, Google Gemini, local proxy)
LLM_BASE_URL=https://api.openai.com/v1

# API key for the LLM provider
LLM_API_KEY=your-llm-api-key-here

# Model identifier to use for completions
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Shared secret for cron job / internal API authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-hex-string

# ------------------------------------------------------------
# Encryption
# ------------------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of webhook credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development

# Base URL for the application (used in email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
