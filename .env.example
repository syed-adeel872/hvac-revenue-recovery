# ============================================================
# HVAC Revenue Recovery — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Public URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anonymous (public) key — safe for client-side use
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct database connection string (for migrations / psql)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------
# LLM Provider (OpenAI-compatible endpoint)
# ------------------------------------------------------------
# Base URL for the LLM API (e.g., OpenAI, Google Gemini, local proxy)
LLM_BASE_URL=https://api.openai.com/v1

# API key for the LLM provider
LLM_API_KEY=your-llm-api-key-here

# Model identifier to use for completions
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Shared secret for cron job / internal API authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-hex-string

# ------------------------------------------------------------
# Encryption
# ------------------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of webhook credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development

# Base URL for the application (used in email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public app URL used to construct Twilio webhook callback URLs
# Set to your deployed Vercel URL in production (e.g., https://your-app.vercel.app)
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Messaging Provider (Twilio)
# ------------------------------------------------------------
# Provider to use for outbound messaging: mock | twilio
MESSAGING_PROVIDER=mock

# Twilio account credentials (required when MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=+15551234567

# Twilio status callback URL (optional — defaults to APP_URL + /api/v1/webhooks/twilio/status)
TWILIO_STATUS_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/twilio/status

# ------------------------------------------------------------
# Twilio Inbound Webhook (for signature verification)
# ------------------------------------------------------------
# TWILIO_AUTH_TOKEN is also used to verify inbound Twilio webhook signatures.

# ------------------------------------------------------------
# Admin seed (used by `npm run seed:admin`)
# ------------------------------------------------------------
# Email for the dashboard admin user
ADMIN_EMAIL=you@yourcompany.com

# Password for the admin user (minimum 12 characters)
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=change-me-to-a-strong-password

# Display name for the default tenant/client
DEFAULT_CLIENT_NAME=Default HVAC Company

# ------------------------------------------------------------
# CRM / FSM Integration (ServiceTitan)
# ------------------------------------------------------------
# ServiceTitan webhook signature verification uses the same webhook credential
# infrastructure stored in the webhook_credentials table (encrypted with ENCRYPTION_KEY).
# No additional environment variables required for ServiceTitan —
# configure via the admin dashboard Integrations page.
